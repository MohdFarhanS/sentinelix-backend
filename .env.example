# Copy this file to .env and fill in the real values.
# .env itself is gitignored — never commit real secrets.

# PostgreSQL (matches docker-compose.yml local setup)
DATABASE_URL=postgres://sentinelix:sentinelix@localhost:5433/sentinelix?sslmode=disable

# Redis (matches docker-compose.yml local setup)
REDIS_URL=redis://localhost:6379

# JWT signing secret — generate a long random string for real environments
JWT_SECRET=change-me-to-a-long-random-secret

# HTTP server port (optional, defaults to 8080)
PORT=8080

# "development" | "production" — affects cookie Secure flag
APP_ENV=development

# Frontend origin, used for CORS whitelist
FRONTEND_URL=http://localhost:3000

# Resend (email notifications)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=onboarding@resend.dev
